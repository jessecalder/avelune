# Copy to .env.local (gitignored). Everything is optional in development:
# without DATABASE_URL signups append to .data/signups.jsonl.

# Postgres connection string (Supabase / Neon / Railway / Vercel Postgres).
# DATABASE_URL=postgres://user:pass@host:5432/avelune

# Resend — sends the "you're on the list" email when set.
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM="Avelune <hello@avelune.com>"

# Where to send a one-line notification for every new signup (optional).
# SIGNUP_NOTIFY_EMAIL=you@example.com

# Canonical site URL for metadata / Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local production runs only: use the JSONL store even with NODE_ENV=production.
# SIGNUP_STORE=file

# ——— Deposits (stage 2 groundwork) ———
# Stripe secret key. Use a test-mode key (sk_test_…) until launch.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
# Signing secret of the webhook endpoint (whsec_…). With the Stripe CLI,
# `stripe listen` prints one for local use.
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
# Master switch. Deposits stay closed unless this is "true" and both
# STRIPE_SECRET_KEY and DATABASE_URL are set.
# DEPOSITS_ENABLED=false
# Deposit amount in the smallest currency unit (cents). The default of 100000
# is a placeholder: the owner must decide the real amount. Minimum 5000.
# DEPOSIT_AMOUNT_CENTS=100000
# Three-letter ISO currency code.
# DEPOSIT_CURRENCY=usd
# Days a paid deposit holds a place (1 to 60). Keep in step with the copy in
# src/content/site.ts, which says fourteen.
# DEPOSIT_HOLD_DAYS=14

# Staging only: "true" hides the whole site from search engines (robots + meta).
# SITE_NOINDEX=true
